<!DOCTYPE html><html lang="en"><head><%- include('partials/head') %></head><body class="tl-body"><%- include('partials/nav') %>
<main class="container-fluid px-3 px-lg-5 py-4">
<div class="tl-hero mb-4"><div><div class="tl-terminal-label">TRADERS LOG // CAPITAL MANAGEMENT</div><h1 class="display-6 fw-bold">TRADING <span class="tl-accent">PORTFOLIO</span></h1><p class="tl-muted mb-0">Track accounts, open positions, unrealized P&amp;L and capital adjustments.</p></div><button class="btn tl-btn-gold" data-bs-toggle="modal" data-bs-target="#accountModal"><i class="bi bi-plus-lg"></i> ACCOUNT</button></div>
<div id="portfolioMetrics" class="row g-3 mb-4"></div>
<div class="row g-3"><div class="col-lg-8"><div class="tl-card p-3"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h5 class="tl-heading mb-0">OPEN POSITIONS</h5><div class="d-flex gap-2"><button class="btn btn-sm btn-outline-light" id="refreshPricesBtn"><i class="bi bi-arrow-repeat"></i> Refresh live prices</button><button class="btn btn-sm btn-outline-light" data-bs-toggle="modal" data-bs-target="#positionModal">Add position</button></div></div><div class="table-responsive"><table class="table tl-table align-middle"><thead><tr><th>Symbol</th><th>Dir</th><th>Qty</th><th>Entry</th><th>Current</th><th>Unrealized</th><th></th></tr></thead><tbody id="positions"></tbody></table></div></div></div>
<div class="col-lg-4"><div class="tl-card p-3 h-100"><h5 class="tl-heading">ACCOUNTS</h5><div id="accounts"></div></div></div></div>
</main>
<div class="modal fade" id="accountModal"><div class="modal-dialog"><form class="modal-content tl-modal" id="accountForm"><div class="modal-header"><h5 class="modal-title">New account</h5></div><div class="modal-body"><input class="form-control tl-select mb-2" name="name" placeholder="Account name" required><input class="form-control tl-select mb-2" name="broker" placeholder="Broker"><select class="form-select tl-select mb-2" name="account_type"><option>DEMO</option><option>LIVE</option></select><input class="form-control tl-select mb-2" name="currency" value="USD"><input class="form-control tl-select" name="initial_balance" type="number" step="any" placeholder="Initial balance"></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn tl-btn-gold">Create</button></div></form></div></div>
<div class="modal fade" id="positionModal"><div class="modal-dialog"><form class="modal-content tl-modal" id="positionForm"><div class="modal-header"><h5 class="modal-title">Add position</h5></div><div class="modal-body"><select id="pInstrument" class="form-select tl-select mb-2" required></select><select name="direction" class="form-select tl-select mb-2"><option>LONG</option><option>SHORT</option></select><input name="quantity" class="form-control tl-select mb-2" type="number" step="any" placeholder="Quantity" required><input name="entry_price" class="form-control tl-select mb-2" type="number" step="any" placeholder="Entry price" required><input name="current_price" class="form-control tl-select mb-2" type="number" step="any" placeholder="Current price"><input name="stop_loss" class="form-control tl-select mb-2" type="number" step="any" placeholder="Stop loss"><input name="take_profit" class="form-control tl-select" type="number" step="any" placeholder="Take profit"></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn tl-btn-gold">Add</button></div></form></div></div>
<div class="modal fade" id="editPositionModal"><div class="modal-dialog"><form class="modal-content tl-modal" id="editPositionForm"><div class="modal-header"><h5 class="modal-title">Update position</h5></div><div class="modal-body"><div class="tl-muted small mb-3" id="editPositionSymbol"></div><label class="tl-label mb-1">Current price (mark to market)</label><input name="current_price" class="form-control tl-select mb-2" type="number" step="any" placeholder="Current price"><label class="tl-label mb-1">Stop loss</label><input name="stop_loss" class="form-control tl-select mb-2" type="number" step="any" placeholder="Stop loss"><label class="tl-label mb-1">Take profit</label><input name="take_profit" class="form-control tl-select mb-2" type="number" step="any" placeholder="Take profit"><label class="tl-label mb-1">Notes</label><textarea name="notes" class="form-control tl-select" rows="2" placeholder="Notes"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn tl-btn-gold">Save</button></div></form></div></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script><script src="/js/portfolio.js"></script><%- include('partials/footer') %>
</body></html>