{
  "name": "traderslog",
  "version": "4.0.0",
  "description": "TRADERS LOG 4.0 \u2014 multi-asset financial markets workstation, scanner, news, journal, portfolio and risk tools",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node db/migrate.js",
    "seed": "node db/seed.js",
    "check": "for f in server.js middleware/*.js controllers/*.js services/*.js routes/*.js providers/*.js config/*.js db/*.js public/js/*.js; do node --check \"$f\" || exit 1; done && echo 'All files passed syntax check.'",
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/*.test.js",
    "lint": "npm run check",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ejs": "^3.1.10",
    "pg": "^8.12.0",
    "dotenv": "^16.4.5",
    "bcryptjs": "^2.4.3",
    "express-session": "^1.18.0",
    "connect-pg-simple": "^9.0.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.4.0",
    "node-fetch": "^2.7.0",
    "ws": "^8.18.0",
    "node-cron": "^3.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
