# =========================================================
# TRADERS LOG // ENVIRONMENT
# =========================================================
PORT=3000
NODE_ENV=development

# Use a long random value in production.
SESSION_SECRET=generate_a_long_random_secret_at_least_32_chars
SESSION_COOKIE_NAME=traderslog.sid

# PostgreSQL
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=traderslog
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# Scanner / API protection
SCANNER_CONCURRENCY=5
API_RATE_LIMIT=180

# Default timezone
DEFAULT_TIMEZONE=Africa/Nairobi

# Market data providers
TWELVE_DATA_API_KEY=
ALPHAVANTAGE_API_KEY=
COINGECKO_API_KEY=

# Reserved extension points for future provider modules
POLYGON_API_KEY=
NEWS_PROVIDER=
NEWS_API_KEY=

# Screenshot storage
UPLOAD_DIR=public/uploads
# Optional macroeconomic calendar provider
FINNHUB_API_KEY=
